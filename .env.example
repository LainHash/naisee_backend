PORT=3001
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000
SWAGGER_ENABLED=true

# PostgreSQL connection string (supports DbConnectionString or DATABASE_URL)
DbConnectionString=postgresql://user:password@localhost:5432/naisee?sslmode=disable
DB_SYNCHRONIZE=true
DB_LOGGING=false
DB_SSL=false

# JWT Authentication
JWT_SECRET=naisee-dev-jwt-secret-change-in-prod
JWT_EXPIRES_IN=7d

# Cloudinary Image Storage (DB only stores secure_url returned by Cloudinary)
# Supports CLOUDINARY_URL or the 3 individual keys below
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=naisee

# Optional AI Vision (fallback to rule-based suggestions when omitted)
GEMINI_API_KEY=
AI_VISION_MODEL=gemini-3.1-flash-lite
